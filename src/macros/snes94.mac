; NHL '94 (SNES) macros. Included once by nhl94snes.asm, before the bank files.

macro String(text)		; length word (counts itself), then the text
?l:	dw ?e-?l
	db "<text>"
?e:
endmacro

macro Player(name, w1, w2, w3, w4)	; length word (counts itself), the name, then the ratings as 4 big-endian words
?l:	dw ?e-?l
	db "<name>"
?e:	db <w1>>>8,<w1>&$FF,<w2>>>8,<w2>&$FF,<w3>>>8,<w3>&$FF,<w4>>>8,<w4>&$FF
endmacro

macro PadTo(addr)		; $FF fill up to addr; the build fails if what comes before has grown past addr
	if pc()&$FFFF != 0		; a bank filled to its last byte leaves pc() at $xx0000 of the next bank: nothing to fill
		assert pc() <= <addr>, "no room: the code or data before this %PadTo runs past <addr>"
		padbyte $FF
		pad <addr>
	endif
endmacro

macro RelocShift()		; after a bank's org: tools/reloctest.sh builds with -DRELOC_SHIFT=n, n $FF bytes that move everything after them
	if defined("RELOC_SHIFT")
		fillbyte $FF
		fill !RELOC_SHIFT
	endif
endmacro
